{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReelDock",
  "version": "0.1.0",
  "identifier": "com.benrobo.reeldock",
  "build": {
    "beforeDevCommand": "bun run vite:dev",
    "beforeBuildCommand": "bun run build:web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReelDock",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:reeldock.db"]
    }
  }
}
