{
  "name": "@reeldock/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri dev",
    "vite:dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "build:web": "vite build",
    "tauri:build": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build",
    "db:generate": "drizzle-kit generate",
    "db:check-migrations": "node scripts/check-tauri-migrations.mjs",
    "db:reset-dev": "node scripts/reset-dev-db.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist src-tauri/target *.tsbuildinfo"
  },
  "dependencies": {
    "@benrobo/iconary": "^0.2.0",
    "@reeldock/devtools": "workspace:*",
    "@reeldock/project-schema": "workspace:*",
    "@reeldock/shared": "workspace:*",
    "@reeldock/tailwind-config": "workspace:*",
    "@reeldock/ui": "workspace:*",
    "@tanstack/react-router": "^1.91.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "drizzle-orm": "^0.45.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tauri-plugin-macos-permissions-api": "^2.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-plugin": "^1.91.0",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
